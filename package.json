{
  "name": "yingchuang",
  "version": "0.3.0",
  "description": "映窗 · 背屏壁纸工作室",
  "author": "映窗",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "package:win": "npm run build && electron-builder --win zip --publish never -c.compression=maximum"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.2.1",
    "@webwallgl/editor": "3.0.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "lucide-react": "^0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.9.3",
    "vite": "8.3.6",
    "webwallgl": "3.0.1"
  },
  "build": {
    "appId": "cn.yingchuang.desktop",
    "productName": "映窗",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "core",
        "to": "core",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "runtime/${os}",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/licenses",
        "to": "licenses"
      },
      {
        "from": "LICENSE",
        "to": "licenses/映窗-MIT许可证.txt"
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "artifactName": "映窗-${version}-Linux-${arch}.${ext}",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "映窗-${version}-Windows-${arch}.${ext}"
    },
    "asarUnpack": [
      "**/*.wasm"
    ],
    "npmRebuild": false,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "compression": "normal"
  },
  "desktopName": "yingchuang.desktop"
}
